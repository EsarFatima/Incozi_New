# =====================================================
# INCOZI - Environment Variables Template
# Copy this to .env and fill in your actual values
# =====================================================

# Application Port
PORT=3000

# =====================================================
# MONGODB CONFIGURATION
# =====================================================
# For Local Development:
MONGODB_DEV_URI=mongodb://localhost:27017/incozi

# For Production (MongoDB Atlas):
# Get this from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/incozi?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/incozi?retryWrites=true&w=majority

# =====================================================
# EMAIL CONFIGURATION (Gmail)
# =====================================================
# 1. Enable 2FA on Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below (remove spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here_16_chars_no_spaces
SMTP_FROM_NAME=Incozi Support
ADMIN_EMAIL=your-email@gmail.com

# =====================================================
# AUTHENTICATION & SECURITY
# =====================================================
# Generate with: openssl rand -hex 64
# Min length: 32 characters (recommended: 64+)
JWT_SECRET=your_very_long_secure_random_string_min_32_chars_recommended_64

# =====================================================
# BASE URL
# =====================================================
# For local development:
# BASE_URL=http://localhost:3000

# For production (replace with your actual domain):
# BASE_URL=https://your-domain.com
BASE_URL=http://localhost:3000

# =====================================================
# PAYMENT GATEWAY (AsaanPay / Stripe)
# =====================================================
# Get these from: https://merchant.asaanpay.com (for Pakistan)
# Or: https://stripe.com for international payments
ASAAN_MERCHANT_ID=your_merchant_id_here
STRIPE_KEY=your_stripe_key_here

# =====================================================
# (DEPRECATED) Supabase Configuration
# =====================================================
# These are deprecated - using MongoDB instead
# Kept for reference only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# =====================================================
# DATABASE CONNECTION (Legacy - not used anymore)
# =====================================================
# These are deprecated - MongoDB is now primary
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password123
DB_NAME=incozi_db
