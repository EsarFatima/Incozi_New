# INCOZI - Full-Stack Consultation Platform
# Copy this file to .env and fill in your actual values

# ===== Server Configuration =====
PORT=3000
NODE_ENV=development

# ===== Supabase Configuration =====
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===== JWT Configuration =====
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# ===== Email Configuration (Nodemailer) =====
EMAIL_SERVICE=gmail
EMAIL_USER=incozillc@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=incozillc@gmail.com

# ===== Stripe Configuration =====
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===== Socket.IO Configuration =====
SOCKET_IO_CORS=http://localhost:3000,http://localhost:5173

# ===== File Upload Configuration =====
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./assets/uploads

# ===== Frontend URL (for CORS and redirects) =====
FRONTEND_URL=http://localhost:5173

# ===== Admin Configuration =====
ADMIN_EMAIL=incozillc@gmail.com
ADMIN_PASSWORD=initial_admin_password_change_me

# ===== Session Configuration =====
SESSION_SECRET=your_session_secret_key_here_change_in_production

# ===== Environment-specific Settings =====
DEBUG=false
LOG_LEVEL=info
